# ─── Supabase ─────────────────────────────────────────────────────────────────
# Proyecto de Supabase → Settings > API
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXXXXXX.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Google Analytics ─────────────────────────────────────────────────────────
# Google Analytics → Admin → Flujos de datos → tu sitio → Measurement ID
# Formato: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google Ads (opcional) ────────────────────────────────────────────────────
# Google Ads → Herramientas → Conversiones → tu conversión → Etiqueta de evento
# Formato: AW-XXXXXXXXX/XXXXXXXXXXXXXXXX
# Si no tienes campaña de Ads todavía, deja esta variable vacía o quítala
VITE_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX/XXXXXXXXXXXXXXXX
